# --- Database (Fly Postgres) ---
DATABASE_URL=

# --- NextAuth (Auth.js v5) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Resend (login code email) ---
RESEND_API_KEY=
RESEND_FROM="WCB <noreply@wcbrusaders.com>"

# --- Member Roster read (REUSE the existing WCB refresh-token creds from LMS/bot) ---
MEMBER_ROSTER_SHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NOTE: for the dashboard's "resources access" indicator, GOOGLE_REFRESH_TOKEN must be
# minted with the admin.directory.group(.member.readonly) scope (the bot's creds already
# carry it). Without it, the Google Group read fails-soft and the Access card is hidden.
GOOGLE_REFRESH_TOKEN=

# --- Members dashboard: Google Group whose membership grants Drive+Calendar access ---
# The dashboard's "resources access" card reads this group's membership (ground truth,
# not the sheet column). Unset -> the group read fails-soft, Access card stays hidden.
MEMBER_ACCESS_GROUP_EMAIL=

# --- Cron guard for the roster sync endpoint ---
CRON_SECRET=

# --- Optional dev bypass (comma-separated emails that skip the roster check) ---
DEV_ALLOWED_EMAILS=
